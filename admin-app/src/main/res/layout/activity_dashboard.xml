<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView android:id="@+id/textProductCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Products: 0"/>
    <TextView android:id="@+id/textOrderCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Orders: 0"/>
    <Button android:id="@+id/buttonManageProducts" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Manage Products"/>
    <Button android:id="@+id/buttonManageOrders" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Manage Orders"/>
</LinearLayout>
