<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/buttonCart" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Cart" />
        <Button android:id="@+id/buttonOrders" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Orders" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerProducts"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</LinearLayout>
